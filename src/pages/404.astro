---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Страница не найдена — Хутбы / Абу Яхья аль-Къирми" noindex>
  <div class="flex flex-col items-center justify-center py-20 text-center">
    <p class="text-6xl font-black text-primary">404</p>
    <h1 class="mt-4 text-2xl font-bold text-foreground">Страница не найдена</h1>
    <p class="mt-2 max-w-md text-sm text-muted-foreground">
      Возможно, страница была перемещена или удалена. Вернитесь на главную, чтобы найти нужную хутбу.
    </p>
    <a
      href="/"
      class="mt-6 inline-flex items-center rounded-xl bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90"
    >
      На главную
    </a>
  </div>
</Layout>
