---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import KhutbaCard from '../../components/KhutbaCard.astro';
import khutbasData from '../../data/khutbas.json';

export function getStaticPaths() {
  const categories = [...new Set(khutbasData.map((k) => k.category))];
  return categories.map((cat) => ({ params: { category: cat } }));
}

const { category } = Astro.params;

const categoryLabels: Record<string, string> = {
  'ramadan': 'Рамадан',
  'sira': 'Жизнеописание Пророка ﷺ',
  'companions': 'Сподвижники',
  'zul-hijjah': 'Зуль-хиджжа',
  'muharram': 'Мухаррам',
  'mawlid': 'Маулид',
  'aqida': 'Акыда и манхадж',
  'names-of-allah': 'Имена Аллаха',
  'shaban': 'Ша\'бан',
  'new-year': 'Новый год',
  'forbidden-deeds': 'Запретные деяния',
  'general': 'Общие',
};

const label = categoryLabels[category] || category;
const khutbas = khutbasData
  .filter((k) => k.category === category)
  .sort((a, b) => parseInt(a.number) - parseInt(b.number));
---

<Layout title={`${label} — Хутбы / Абу Яхья аль-Къирми`}>
  <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Темы', href: '/categories' }, { label }]} />

  <header class="mb-6 border-b border-border pb-6" data-category={category}>
    <h1 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">{label}</h1>
    <span class="mt-4 inline-flex items-center rounded-full bg-secondary px-2.5 py-1 text-xs font-medium text-secondary-foreground">
      {khutbas.length} хутб
    </span>
  </header>

  {khutbas.length === 0 && (
    <p class="py-8 text-center text-muted-foreground">Нет хутб в этой категории.</p>
  )}

  <div class="grid grid-cols-1 gap-4 pb-10 sm:grid-cols-2 lg:grid-cols-3">
    {khutbas.map((k) => <KhutbaCard khutba={k} />)}
  </div>
</Layout>
