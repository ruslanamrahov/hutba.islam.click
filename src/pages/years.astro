---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import khutbasData from '../data/khutbas.json';

const years = [...new Set(khutbasData.map((k) => k.year))].filter((y) => y !== 0).sort((a, b) => a - b);
const yearCounts = years.map((y) => ({
  year: y,
  count: khutbasData.filter((k) => k.year === y).length,
}));
---

<Layout title="Хутбы по годам — Хутбы / Абу Яхья аль-Къирми">
  <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Года' }]} />

  <header class="mb-6 border-b border-border pb-6">
    <h1 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">Хутбы по годам</h1>
  </header>

  <section class="pb-10">
    <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3">
      {yearCounts.map(({ year, count }) => (
        <a
          href={`/year/${year}`}
          class="flex items-center justify-between rounded-xl border border-border bg-card card-shadow p-4 transition-colors hover:border-primary"
        >
          <span class="text-sm font-semibold text-card-foreground">
            {year < 2015 ? `До ${year}` : `${year} год`}
          </span>
          <span class="text-xs text-muted-foreground">{count}</span>
        </a>
      ))}
    </div>
  </section>
</Layout>
