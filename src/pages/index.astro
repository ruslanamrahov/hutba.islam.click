---
import Layout from '../layouts/Layout.astro';
import KhutbaAccordion from '../components/KhutbaAccordion.vue';
import khutbasData from '../data/khutbas.json';

const categoryLabels: Record<string, string> = {
  'ramadan': 'Рамадан',
  'sira': 'Жизнеописание Пророка ﷺ',
  'companions': 'Сподвижники',
  'zul-hijjah': 'Зуль-хиджжа',
  'muharram': 'Мухаррам',
  'mawlid': 'Маулид',
  'aqida': 'Акыда и манхадж',
  'names-of-allah': 'Имена Аллаха',
  'shaban': 'Ша\'бан',
  'new-year': 'Новый год',
  'forbidden-deeds': 'Запретные деяния',
  'general': 'Общие',
};
---

<Layout title="Хутбы / Абу Яхья аль-Къирми — Каталог хутб">
  <section class="hero-pattern rounded-2xl px-6 py-8 text-center sm:py-12">
    <h1 class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
      Хутбы / Абу Яхья аль-Къирми
    </h1>
    <p class="mx-auto mt-2 max-w-xl text-base text-muted-foreground sm:text-lg">
      Пятничные (джумуа) и праздничные (Ид аль-Фитр и Ид аль-Атха)
    </p>
  </section>

  <section class="mt-6 pb-10">
    <KhutbaAccordion
      khutbas={khutbasData}
      categoryLabels={categoryLabels}
      client:load
    />
  </section>
</Layout>
